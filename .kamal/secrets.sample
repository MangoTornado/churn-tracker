# Copy to .kamal/secrets and fill in. That file is gitignored — it holds real credentials.
#
# Kamal reads these when building the `env.secret` list in config/deploy.yml. Anything left blank is
# simply not passed to the container.
#
# There are only two, and that is the whole list. This server holds no third-party credential: it
# talks to a public web page and to Expo's unauthenticated push endpoint, and it stores nothing that
# could log in to a bank. See the note in config/deploy.yml.

# --- container registry (required) ---
KAMAL_REGISTRY_USERNAME=
KAMAL_REGISTRY_PASSWORD=
