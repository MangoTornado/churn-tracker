{
  "expo": {
    "name": "Churn Tracker",
    "slug": "churn-tracker",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "churntracker",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#17161C",
    "splash": {
      "backgroundColor": "#17161C",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "tw.asu.churntracker",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "tw.asu.churntracker",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#17161C"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#B9A0F5"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
