{
  "expo": {
    "name": "Churn Tracker",
    "slug": "churn-tracker",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "churntracker",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#17161C",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#17161C",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "tw.asu.churntracker",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "tw.asu.churntracker",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#17161C"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#B9A0F5"
        }
      ],
      "./plugins/with-release-signing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png"
  }
}
